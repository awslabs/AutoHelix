env.sh
TODO.md

# AutoHelix configs for working on this repo (autohelix/NAME.yaml), kept local.
# Runs save their own copy of the config, so these need no commit. Anything a
# run reads besides the config and its prompt template must be committed elsewhere.
/autohelix/

# uv lockfile: not used (installs go through pip / uv pip install -e .)
uv.lock
